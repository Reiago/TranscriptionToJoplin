# Joplin Desktop > Options > Web Clipper > "Activer le service Web Clipper"
# Copie le token affiché et le port (41184 par defaut)
JOPLIN_TOKEN=
JOPLIN_PORT=41184

# Optionnel: nom du carnet (notebook) Joplin ou creer les notes.
# Laisser vide pour utiliser le carnet par defaut. Si le carnet n'existe pas,
# il sera cree automatiquement.
JOPLIN_NOTEBOOK=YT-Transcript
